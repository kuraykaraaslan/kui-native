{
  "expo": {
    "name": "KUInative",
    "slug": "kui-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kuinative",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/favicon.png",
      "name": "KUInative",
      "shortName": "kui native",
      "themeColor": "#3b82f6",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png"
  }
}
