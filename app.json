{
  "expo": {
    "name": "KUInative",
    "slug": "kui-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kuinative",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-status-bar"
    ]
  }
}
