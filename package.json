    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  }
